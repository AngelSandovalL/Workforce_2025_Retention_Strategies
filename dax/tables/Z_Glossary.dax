Glossary = DATATABLE (
    "Term (Metric/Field)", STRING,
    "Definition", STRING,
    "Category", STRING,
    {

        { "Total Terminations", "Conteo total de bajas (STATUS = TERMINATED). Fuente: F_EmployeeHistory.", "Métrica Principal" },
        { "HC Closing", "Headcount al cierre del periodo (31 Dic). Fuente: F_Headcount.", "Métrica Base" },
        { "HC Opening", "Headcount al cierre del año anterior.", "Métrica Base" },
        { "HC AVG", "Promedio anual (Inicial + Final) / 2. Denominador para tasas.", "Cálculo" },
        { "Attrition Rate %", "Tasa de rotación (Bajas / HC AVG).", "KPI Estratégico" },
        { "HC Latest", "Headcount activo más reciente.", "KPI" },
        

        { "Department", "Unidad funcional del empleado.", "Dimensión Org" },
        { "Voluntary", "Renuncias y Retiros (Decisión empleado).", "Concepto de Negocio" },
        { "Involuntary", "Despidos y Recortes (Decisión empresa).", "Concepto de Negocio" },
        

        { "Danger Zone", "Cuadrante Crítico (Alta Tasa / Alto HC). Áreas grandes perdiendo personal. Prioridad Máxima.", "Matriz de Riesgo" },
        { "Warning Zone", "Cuadrante de Alerta (Alta Tasa / Bajo HC). Áreas pequeñas con fugas porcentuales altas.", "Matriz de Riesgo" },
        { "Stable Zone", "Cuadrante de Estabilidad (Baja Tasa / Alto HC). Áreas grandes que retienen talento (Pilares).", "Matriz de Riesgo" },
        { "Safe Zone", "Cuadrante Seguro (Baja Tasa / Bajo HC). Áreas pequeñas sin problemas de retención.", "Matriz de Riesgo" }
    }
)